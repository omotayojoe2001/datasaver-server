<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer circle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#333333" />
            <stroke android:width="3dp" android:color="#666666" />
            <size android:width="120dp" android:height="120dp" />
        </shape>
    </item>
    <!-- Inner power icon ring -->
    <item android:left="35dp" android:top="35dp" android:right="35dp" android:bottom="35dp">
        <shape android:shape="oval">
            <stroke android:width="3dp" android:color="#AAAAAA" />
            <size android:width="50dp" android:height="50dp" />
        </shape>
    </item>
    <!-- Power icon line (top) -->
    <item android:left="57dp" android:top="25dp" android:right="57dp" android:bottom="65dp">
        <shape android:shape="rectangle">
            <solid android:color="#AAAAAA" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
